{
  "name": "violence",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "hostRequirements": {
    "cpus": 8,
    "memory": "32gb",
    "storage": "128gb"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "36.markdown-auto-link-title",
        "aaron-bond.better-comments",
        "adpyke.codesnap",
        "akamud.vscode-theme-onedark",
        "albert.tabout",
        "anthropic.claude-code",
        "asvetliakov.vscode-neovim",
        "aykutsarac.jsoncrack-vscode",
        "be5invis.vscode-icontheme-nomo-dark",
        "bierner.markdown-mermaid",
        "bierner.markdown-preview-github-styles",
        "bpruitt-goddard.mermaid-markdown-syntax-highlighting",
        "christian-kohler.path-intellisense",
        "davidanson.vscode-markdownlint",
        "docker.docker",
        "donjayamanne.githistory",
        "dotenv.dotenv-vscode",
        "dzhavat.bracket-pair-toggler",
        "eamodio.gitlens",
        "esbenp.prettier-vscode",
        "formulahendry.auto-rename-tag",
        "foxundermoon.shell-format",
        "github.codespaces",
        "github.remotehub",
        "github.vscode-github-actions",
        "gruntfuggly.todo-tree",
        "hbenl.vscode-test-explorer",
        "hwencc.html-tag-wrapper",
        "jellydn.fzf-picker",
        "joephilip.markdown-code-snippets",
        "jonlester.markdown-preview-export",
        "maciejdems.add-to-gitignore",
        "mathematic.vscode-pdf",
        "mechatroner.rainbow-csv",
        "mhutchie.git-graph",
        "mikestead.dotenv",
        "ms-vscode-remote.remote-containers",
        "ms-vscode-remote.remote-ssh",
        "ms-vscode-remote.remote-ssh-edit",
        "ms-vscode-remote.remote-wsl",
        "ms-vscode-remote.vscode-remote-extensionpack",
        "ms-vscode.azure-repos",
        "ms-vscode.powershell",
        "ms-vscode.remote-explorer",
        "ms-vscode.remote-repositories",
        "ms-vscode.remote-server",
        "ms-vscode.test-adapter-converter",
        "oderwat.indent-rainbow",
        "pflannery.vscode-versionlens",
        "pkief.material-icon-theme",
        "redhat.vscode-yaml",
        "shahilkumar.docxreader",
        "softwareape.numbermonger",
        "souravahmed.flash-vscode-latest",
        "techer.open-in-browser",
        "tomoki1207.pdf",
        "tomoyukim.vscode-mermaid-editor",
        "usernamehw.errorlens",
        "vstirbu.vscode-mermaid-preview",
        "wix.vscode-import-cost",
        "yzhang.markdown-all-in-one"
      ],
      "settings": {
        "workbench.sideBar.location": "right",
        "workbench.activityBar.location": "top",
        "editor.fontFamily": "CaskaydiaCove Nerd Font",
        "editor.inlineSuggest.fontFamily": "CaskaydiaCove Nerd Font",
        "terminal.integrated.fontFamily": "CaskaydiaCove Nerd Font"
      }
    }
  },
  "postCreateCommand": "bash install.sh"
}
